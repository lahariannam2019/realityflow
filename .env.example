# ==============================================================================
# RealityFlow Environment Configuration
# ==============================================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-Side Only Service Role Key (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional Development / Test Staff Account
# If set, enables instant testing in development mode without exposing passwords in source
TEST_STAFF_EMAIL=staff@realityflow.local
TEST_STAFF_PASSWORD=ChangeMeInProduction123!
